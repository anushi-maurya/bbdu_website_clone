<section class="page-banner"
    style="background-image: url('images/life-banner.jpg');">

    <div class="page-banner-content">
        <h1>Life at BBDU</h1>
        <p>Learning, friendship, creativity and memorable experiences</p>
    </div>

</section>

<section class="section-padding">

    <div class="container">

        <div class="section-title">
            <h2>Experience Campus <span>Life</span></h2>
            <p>
                Explore facilities and activities that support academic
                and personal development.
            </p>
            <div class="title-line"></div>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="life-card">

                    <img src="images/life-library.jpg"
                         alt="Library">

                    <div class="card-content">
                        <h4>Central Library</h4>
                        <p>
                            A learning space with books, journals,
                            digital resources and reading areas.
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="life-card">

                    <img src="images/life-sports.jpg"
                         alt="Sports">

                    <div class="card-content">
                        <h4>Sports and Fitness</h4>
                        <p>
                            Indoor and outdoor activities encouraging
                            fitness, teamwork and sportsmanship.
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="life-card">

                    <img src="images/life-hostel.jpg"
                         alt="Hostel">

                    <div class="card-content">
                        <h4>Hostel Facilities</h4>
                        <p>
                            Comfortable residential facilities with a
                            safe and supportive environment.
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="life-card">

                    <img src="images/life-events.jpg"
                         alt="Events">

                    <div class="card-content">
                        <h4>Cultural Events</h4>
                        <p>
                            Festivals, competitions and student events
                            celebrating creativity and diversity.
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="life-card">

                    <img src="images/life-lab.jpg"
                         alt="Laboratory">

                    <div class="card-content">
                        <h4>Modern Laboratories</h4>
                        <p>
                            Practical learning supported by modern
                            equipment and technical facilities.
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="life-card">

                    <img src="images/life-clubs.jpg"
                         alt="Student Clubs">

                    <div class="card-content">
                        <h4>Student Clubs</h4>
                        <p>
                            Technical, cultural and social clubs for
                            developing skills beyond academics.
                        </p>
                    </div>

                </div>
            </div>

        </div>

    </div>

</section>

